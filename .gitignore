# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Exception: RDS's CA bundle is a public trust-store file (no secret
# material), committed so deploys don't need a separate fetch step.
!certs/rds-global-bundle.pem

# debug
npm-debug.log*

# Local database files — the dev Postgres cluster lives here. Never commit:
# these are the raw data files, so anything registered through the local
# portal would end up in version control.
/data

# env files — never commit secrets.
# .env.local was tracked during the demo phase and has been removed from
# version control. The secrets it held are still readable from git history,
# so every one of them was rotated at the same time — see SECURITY-RISK-ANALYSIS.md
# finding T-01. Never commit this file again.
.env
.env.local
.env.local.backup-*
.env.development.local
.env.test.local
.env.production.local

# typescript
*.tsbuildinfo
next-env.d.ts
.claude/settings.local.json
